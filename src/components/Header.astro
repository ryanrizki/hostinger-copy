---
import Logo from './Logo.astro';
type Nav = typeof import('../content/id.json')['nav'];
interface Props { nav: Nav; brand: string }
const { nav, brand } = Astro.props;
const chevron = 'M6 9l6 6 6-6';
---
<header class="sticky top-0 z-40 bg-night shadow-[0_4px_10px_rgba(0,0,0,0.1)]">
  <nav class="flex h-[58px] items-center justify-between px-5 md:h-18 md:px-10" aria-label="Utama">
    <div class="flex items-center gap-12">
      <Logo brand={brand} />
      <ul class="hidden items-center gap-2 lg:flex">
        {nav.items.map((i) => (
          <li class="relative">
            {i.links ? (
              <details class="group">
                <summary class="flex h-10 cursor-pointer list-none items-center gap-1 rounded-lg px-3 text-white hover:bg-white/10 [&::-webkit-details-marker]:hidden">
                  {i.label}
                  <svg aria-hidden="true" class="size-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={chevron} /></svg>
                </summary>
                <ul class="absolute left-0 top-12 min-w-52 rounded-xl bg-white p-2 shadow-lg">
                  {i.links.map((l) => <li><a href="#" class="block rounded-lg px-3 py-2 text-ink hover:bg-card">{l}</a></li>)}
                </ul>
              </details>
            ) : (
              <a href={i.href} class="flex h-10 items-center rounded-lg px-3 text-white hover:bg-white/10">{i.label}</a>
            )}
          </li>
        ))}
      </ul>
    </div>

    <div class="flex items-center gap-2 text-white">
      <span class="hidden h-10 items-center gap-2 px-3 lg:flex">
        <span aria-hidden="true" class="size-4 rounded-full bg-[linear-gradient(#e11d48_50%,#fff_50%)]"></span>{nav.lang}
      </span>
      <a href="#" class="hidden size-10 place-items-center rounded-lg hover:bg-white/10 lg:grid" aria-label={nav.account}>
        <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12a5 5 0 100-10 5 5 0 000 10zm0 2c-5 0-9 2.5-9 6v2h18v-2c0-3.5-4-6-9-6z" /></svg>
      </a>

      <details class="lg:hidden">
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-lg hover:bg-white/10 [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg aria-hidden="true" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <ul class="absolute inset-x-0 top-[58px] bg-night px-5 pb-6">
          {nav.items.map((i) => <li><a href={i.href ?? '#'} class="block border-b border-white/10 py-4 text-white">{i.label}</a></li>)}
        </ul>
      </details>
    </div>
  </nav>
</header>
