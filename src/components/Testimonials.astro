---
type Props = typeof import('../content/id.json')['testimonials'];
const t = Astro.props;
---
<section class="section" aria-labelledby="testimoni">
  <div class="wrap">
    <h2 id="testimoni" class="h2 mx-auto max-w-[646px] text-center">{t.title}</h2>
    <ul
      data-reviews
      class="mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto [scrollbar-width:none] md:mx-auto md:grid md:max-w-[1232px] md:grid-cols-3 md:overflow-visible"
      tabindex="0"
      aria-label={t.title}
    >
      {t.items.map((i) => (
        <li class="flex w-full shrink-0 snap-center flex-col gap-6 rounded-2xl bg-card p-6 md:w-auto md:p-8">
          <svg aria-hidden="true" class="h-5 w-6 text-brand" viewBox="0 0 24 20" fill="currentColor"><path d="M0 20V11C0 4.6 3.4.9 9.5 0l1 2.4C7 3.4 5.4 5.6 5.2 9H10v11zm13.5 0V11c0-6.4 3.4-10.1 9.5-11l1 2.4c-3.5 1-5.1 3.2-5.3 6.6h4.8v11z" /></svg>
          <blockquote class="flex-1 text-ink">{i.quote}</blockquote>
          <p class="text-xl font-bold tracking-tight text-ink">{i.partner}</p>
        </li>
      ))}
    </ul>
    <div class="mt-6 flex justify-center gap-2 md:hidden" aria-hidden="true">
      {t.items.map((_, n) => <span data-dot class:list={['h-2 rounded-full bg-ink transition-all', n === 0 ? 'w-6' : 'w-2 opacity-30']}></span>)}
    </div>
    <p class="mt-6 text-center text-sm text-muted">{t.note}</p>
  </div>
</section>

<script>
  // Mobile dot pager: highlight the card that is in view.
  const list = document.querySelector('[data-reviews]')!;
  const cards = [...list.children];
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const n = cards.indexOf(e.target);
      dots.forEach((d, i) => {
        d.classList.toggle('w-6', i === n);
        d.classList.toggle('w-2', i !== n);
        d.classList.toggle('opacity-30', i !== n);
      });
    }
  }, { root: list, threshold: 0.6 });
  cards.forEach((c) => io.observe(c));
</script>
