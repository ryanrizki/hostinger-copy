---
type Props = typeof import('../content/id.json')['testimonials'];
const t = Astro.props;
const initials = (name: string) => name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---
<section class="bg-surface-alt py-16 md:py-24" aria-labelledby="testimoni">
  <div class="mx-auto max-w-6xl px-4">
    <h2 id="testimoni" class="text-center text-3xl font-bold md:text-4xl">{t.title}</h2>
    <ul
      class="mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 md:grid md:grid-cols-3 md:overflow-visible"
      tabindex="0"
      aria-label={t.title}
    >
      {t.items.map((i) => (
        <li class="shrink-0 basis-[85%] snap-start md:basis-auto">
          <figure class="flex h-full flex-col rounded-2xl border border-line bg-white p-6 shadow-sm">
            <blockquote class="flex-1 text-ink">“{i.quote}”</blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span aria-hidden="true" class="grid size-10 place-items-center rounded-full bg-brand text-sm font-bold text-white">{initials(i.name)}</span>
              <span>
                <span class="block font-semibold">{i.name}</span>
                <span class="block text-sm text-muted">{i.role}</span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-center text-sm text-muted">{t.note}</p>
  </div>
</section>
