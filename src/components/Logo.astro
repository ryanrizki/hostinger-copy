---
// Own mark: a cloud glyph + wordmark. Not derived from any real brand.
interface Props { brand: string; dark?: boolean }
const { brand, dark } = Astro.props;
---
<a href="/" class:list={['inline-flex items-center gap-2 font-bold', dark ? 'text-ink' : 'text-white']}>
  <svg aria-hidden="true" class="h-6 w-8" viewBox="0 0 32 24" fill="currentColor"><path d="M9 22a7 7 0 01-1-13.9A9 9 0 0125 7a7.5 7.5 0 01-1 15z" /></svg>
  <span class="text-lg tracking-tight">{brand}</span>
</a>
