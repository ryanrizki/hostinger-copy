---
type Props = typeof import('../content/id.json')['benefits'];
const b = Astro.props;
const icons: Record<string, string> = {
  trend: 'M3 17l6-6 4 4 8-8M15 7h6v6',
  percent: 'M19 5L5 19M7 9a2 2 0 100-4 2 2 0 000 4zM17 19a2 2 0 100-4 2 2 0 000 4z',
  kit: 'M4 5h16v14H4zM4 15l5-5 4 4 3-3 4 4',
};
---
<section class="section bg-lavender" aria-labelledby="manfaat">
  <div class="wrap">
    <h2 id="manfaat" class="h2 mx-auto max-w-[646px] text-center">{b.title}</h2>
    <div class="mt-10 grid items-center gap-10 md:mt-12 md:grid-cols-2 md:gap-20">
      <ul class="space-y-6">
        {b.items.map((i) => (
          <li class="flex gap-4">
            <svg aria-hidden="true" class="mt-1 size-6 shrink-0 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={icons[i.icon]} /></svg>
            <div>
              <h3 class="text-xl font-semibold leading-7 text-ink">{i.title}</h3>
              <p class="mt-1">{i.text}</p>
            </div>
          </li>
        ))}
      </ul>

      <!-- Own illustration: dashboard cards on a violet panel. -->
      <div class="relative aspect-[600/491] w-full" aria-hidden="true">
        <div class="absolute inset-[8%_4%_0_14%] rounded-2xl bg-brand/80"></div>
        <div class="absolute inset-[14%_10%_8%_20%] rounded-2xl bg-brand"></div>
        <svg class="absolute bottom-[8%] left-[38%] h-[70%]" viewBox="0 0 200 260" fill="none">
          <circle cx="100" cy="70" r="46" fill="#f8f9fa" />
          <path d="M20 260c0-60 36-110 80-110s80 50 80 110z" fill="#110c29" />
        </svg>
        <div class="absolute left-0 top-[18%] w-[42%] rounded-xl bg-white p-4 shadow-lg">
          <p class="text-xs text-muted">{b.card.label}</p>
          <p class="text-2xl font-semibold text-ink">{b.card.value} <span class="text-sm text-success">{b.card.delta}</span></p>
          <svg class="mt-2 h-10 w-full" viewBox="0 0 120 40" preserveAspectRatio="none"><path d="M0 34l20-8 18 4 22-16 20 6 20-14 20-4" stroke="#673de6" stroke-width="2.5" fill="none" /></svg>
        </div>
        <div class="absolute bottom-[12%] right-0 w-[36%] rounded-xl bg-white/90 p-4 text-center shadow-lg backdrop-blur">
          <span class="mx-auto grid size-8 place-items-center rounded-full bg-brand text-white">✓</span>
          <p class="mt-2 text-xl font-semibold text-ink">{b.card.payout}</p>
          <p class="text-xs text-muted">{b.card.payoutLabel}</p>
        </div>
      </div>
    </div>
  </div>
</section>
