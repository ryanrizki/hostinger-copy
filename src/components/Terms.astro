---
type Props = typeof import('../content/id.json')['terms'];
const t = Astro.props;
---
<section class="section" aria-labelledby="syarat">
  <div class="wrap grid items-center gap-10 md:grid-cols-2 md:gap-20">
    <!-- Own illustration: laptop + approved card + violet blocks. -->
    <div class="relative order-2 aspect-[600/491] w-full md:order-1" aria-hidden="true">
      <div class="absolute left-[8%] top-[6%] h-[18%] w-[14%] bg-brand/70"></div>
      <div class="absolute bottom-[6%] right-[10%] h-[14%] w-[12%] bg-brand/40"></div>
      <div class="absolute inset-[14%_6%_14%_12%] rounded-2xl bg-lavender"></div>
      <svg class="absolute bottom-[16%] left-[10%] w-[60%]" viewBox="0 0 300 190" fill="none">
        <rect x="40" y="10" width="220" height="140" rx="10" fill="#18181a" />
        <rect x="52" y="22" width="196" height="116" rx="4" fill="#f5f6ff" />
        <rect x="70" y="44" width="110" height="10" rx="5" fill="#673de6" />
        <rect x="70" y="66" width="150" height="8" rx="4" fill="#dadce0" />
        <rect x="70" y="84" width="130" height="8" rx="4" fill="#dadce0" />
        <path d="M0 160h300l-20 22H20z" fill="#4a4a55" />
      </svg>
      <div class="absolute right-[12%] top-[22%] w-[30%] rounded-2xl bg-white p-4 text-center shadow-lg">
        <span class="mx-auto grid size-12 place-items-center rounded-full border-4 border-brand text-xl font-bold text-brand">✓</span>
        <p class="mt-2 text-sm font-semibold text-ink">{t.badge}</p>
      </div>
    </div>

    <div class="order-1 md:order-2">
      <h2 id="syarat" class="text-[28px] leading-9 md:text-4xl md:leading-11">{t.title}</h2>
      <p class="mt-4">{t.text}</p>
      <a href="#" class="btn mt-8 w-full md:w-auto">{t.cta}</a>
    </div>
  </div>
</section>
