---
type Props = typeof import('../content/id.json')['hero'];
const h = Astro.props;
---
<section class="bg-ink pb-12 pt-6 text-center md:pb-28 md:pt-16">
  <div class="mx-auto max-w-3xl px-4">
    <p class="font-semibold text-brand-on-dark">{h.eyebrow}</p>
    <h1 class="mt-3 text-4xl font-extrabold leading-tight text-white md:text-6xl">{h.title}</h1>
    <p class="mx-auto mt-5 max-w-[60ch] text-lg text-on-dark">{h.subtitle}</p>
    <p class="mt-6 inline-block rounded-full bg-brand/20 px-4 py-1 font-bold text-brand-on-dark">{h.commission}</p>
    <div class="mt-8"><a href="#daftar" class="btn">{h.cta}</a></div>
    <ul class="mt-8 flex flex-col items-center gap-2 text-sm text-on-dark md:flex-row md:justify-center md:gap-6">
      {h.facts.map((f) => (
        <li class="flex items-center gap-2">
          <svg aria-hidden="true" class="size-4 text-brand-on-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7" /></svg>
          {f}
        </li>
      ))}
    </ul>
  </div>
</section>
