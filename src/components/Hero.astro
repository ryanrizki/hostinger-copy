---
type Props = typeof import('../content/id.json')['hero'];
const h = Astro.props;
---
<section class="bg-night px-4 pb-20 pt-10 text-center md:px-10 md:pb-24 md:pt-20">
  <h1 class="mx-auto max-w-[646px] text-[40px] leading-12 text-on-dark md:text-[56px] md:leading-16">{h.title}</h1>
  <p class="mx-auto mt-4 max-w-[646px] text-on-dark">{h.subtitle}</p>
  <a href="/daftar" class="btn mt-8 w-full md:w-auto">{h.cta}</a>
</section>
