---
// Dark full-width call-to-action band (FAQ + final CTA).
interface Props { title: string; text: string; cta: string; href: string; id: string }
const { title, text, cta, href, id } = Astro.props;
---
<section class="section bg-band px-4 text-center" aria-labelledby={id}>
  <h2 id={id} class="h2 text-white">{title}</h2>
  <p class="mx-auto mt-4 max-w-[770px] text-white">{text}</p>
  <a href={href} class="btn mt-8 w-full md:w-auto">{cta}</a>
</section>
