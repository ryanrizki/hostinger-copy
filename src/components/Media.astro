---
type Props = typeof import('../content/id.json')['media'];
const m = Astro.props;
---
<section class="section bg-lavender-soft" aria-labelledby="media">
  <div class="wrap text-center">
    <h2 id="media" class="h2">{m.title}</h2>
    <p class="mx-auto mt-4 max-w-[646px]">{m.text}</p>
    <a href="#" class="mt-8 inline-flex min-h-12 w-full items-center justify-center rounded-xl border border-brand px-10 py-3 font-semibold text-brand transition-colors hover:bg-brand/5 md:w-auto">{m.cta}</a>
    <!-- Video slot (source embeds a video here). Placeholder: no third-party embed. -->
    <figure class="mx-auto mt-10 max-w-[1138px] md:mt-12">
      <div class="relative grid aspect-video place-items-center overflow-hidden rounded-2xl bg-night">
        <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(circle_at_30%_30%,#673de6_0,transparent_55%)] opacity-60"></div>
        <span aria-hidden="true" class="relative grid size-16 place-items-center rounded-full bg-white/90 md:size-20">
          <svg class="ml-1 size-7 text-brand md:size-9" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
        </span>
      </div>
      <figcaption class="mt-3 text-sm text-muted">{m.video}</figcaption>
    </figure>
  </div>
</section>
